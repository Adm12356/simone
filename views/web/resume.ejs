
<%- include('header.ejs') %>


 <section class="section" id="resume">
      <div class="container">
        <div class="section-head">
          <div class="section-bg-title">Summary</div>
          <h2 class="section-title">Resume</h2>
        </div>
        <div class="resume-cols">
          <div>
            <h3>My Education</h3>
            <% for(var i=0;i<education.length;i++){ %>
            <article class="timeline-card">
              <span class="badge"><%= education[i].e_year %></span>
              <h4><%= education[i].e_title %></h4>
              <div class="place"><%= education[i].e_university %></div>
              <p><%= education[i].e_desc %></p>
            </article>
            <% } %>

            <!-- <article class="timeline-card">
              <span class="badge">2005 - 2008</span>
              <h4>Bachelor Degree</h4>
              <div class="place">University of California</div>
