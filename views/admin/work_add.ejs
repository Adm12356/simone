<%- include('header.ejs') %>


      <div class="main">
        <header class="topbar">
          <h2>Add Work record</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>Work form</h3>
            <p class="hint">Static template only. Submit stays on this page.</p>

            <form class="form" action="/admin/work_save" method="post" enctype="multipart/form-data">
              <div class="row">
                <div class="field">
                  <label for="name">work Image</label>
                  <input id="name" type="file" name="w_img" placeholder="" />
                </div>
                <div class="field">
                  <label for="email">work Title</label>
                  <input id="email" type="text" name="w_title" placeholder="title......" />
                </div>
              </div>
              
              

              <div class="field">
                <label for="notes">work Description</label>
                <textarea id="notes" name="w_desc" placeholder="Short note..."></textarea>
              </div>

              <div class="actions">
                <button class="btn" type="submit">Save</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
<%- include('footer.ejs') %>

