<%- include('header.ejs') %>


      <div class="main">
        <header class="topbar">
          <h2>Add Home record</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>Home form</h3>
            <p class="hint">Static template only. Submit stays on this page.</p>

            <form class="form" action="/admin/home_home_save/<%=home.hid%>/<%=home.h_img%>" method="post" enctype="multipart/form-data">
              <div class="row">
                <div class="field">
                  <label for="name">Home Image</label>
                  <input id="name" type="file" name="w_img"  placeholder="" />
                  <img src="image/<%=home.h_img%>" alt="" height="200px" width="200px">
                </div>
                <div class="field">
                  <label for="email">Home Title1</label>
                  <input id="email" type="text" name="h_title1" value="<%=home.h_title1%>" placeholder="title......" />
                </div>
                <div class="field">
                  <label for="email">Home Title2</label>
                  <input id="email" type="text" name="h_title2" value="<%=home.h_title2%>" placeholder="title......" />
                </div>
                <div class="field">
                  <label for="email">Home Title3</label>
                  <input id="email" type="text" name="h_title3" value="<%=home.h_title3%>" placeholder="title......" />
                </div>
              </div>
              
              

              <div class="field">
                <label for="notes">Home Description</label>
                <textarea id="notes" name="h_desc" value="<%=home.h_desc%>" placeholder="Short note..."></textarea>
              </div>

              <div class="actions">
                <button class="btn" type="submit">Update</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
<%- include('footer.ejs') %>

