<%- include('header.ejs') %>


      <div class="main">
        <header class="topbar">
          <h2>Education table</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>All users</h3>
            <p class="hint">Sample rows for layout only.</p>

            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Year</th>
                  <th>Title</th>
                  <th>Company</th>
                  <th>Description</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% for(var i=0;i<experience.length;i++){ %>
                <tr>
                  <td><%= i+1 %></td>
                  <td><%= experience[i].ex_year %></td>
                  <td><%= experience[i].ex_title %></td>
                  <td><%= experience[i].ex_company %></td>
                  <td><%= experience[i].ex_desc %></td>
                  <td>
                    <span class="badge badge-ok">Delete</span>
                    <span class="badge badge-ok">Edit</span>
                </td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
<%- include('footer.ejs') %>

