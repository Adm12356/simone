<%- include('header.ejs') %>


      <div class="main">
        <header class="topbar">
          <h2>Contact Table</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>Contact Table</h3>
            <p class="hint">Sample rows for layout only.</p>

            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Name</th>
                  <th>Name</th>
                  <th>Message</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% for(var i=0;i<contact.length;i++){ %>
                <tr>
                  <td><%= i+1 %></td>
                  <td><%= contact[i].name %></td>
                  <td><%= contact[i].email %></td>
                  <td><%= contact[i].message %></td>
                  <td><%= contact[i].cdate %></td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
<%- include('footer.ejs') %>

